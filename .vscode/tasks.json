{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Server run",
            "type": "shell",
            "options": {
                "cwd": "${workspaceFolder}/tfgpoker"
            },
            "windows": {
                "command": ".\\mvnw.cmd",
                "args": [
                    "-pl",
                    "server",
                    "-Prun",
                    "exec:java"
                ]
            },
            "linux": {
                "command": "mvn",
                "args": [
                    "-pl",
                    "server",
                    "-Prun",
                    "exec:java"
                ]
            }
        },
        {
            "label": "Run JavaFX",
            "type": "shell",
            "options": {
                "cwd": "${workspaceFolder}/tfgpoker"
            },
            "windows": {
                "command": ".\\mvnw.cmd",
                "args": [
                    "-pl",
                    "client",
                    "-Prun",
                    "javafx:run"
                ]
            },
            "linux": {
                "command": "mvn",
                "args": [
                    "-pl",
                    "client",
                    "javafx:run"
                ]
            }
        }
    ]
}