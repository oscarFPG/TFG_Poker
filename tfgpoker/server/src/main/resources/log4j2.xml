<?xml version="1.0" encoding="UTF-8"?>

<Configuration status="WARN">

    <Appenders>
        <!-- Console Appender (DEBUG+) + use different colors for each level -->
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout 
                pattern="%d{yyyy/MM/dd HH:mm:ss} -> %highlight{[%-5level]}{
                        DEBUG=white,
                        INFO=green,
                        WARN=yellow,
                        ERROR=red,
                        FATAL=bright_red
                    } : %msg%n"/>
        </Console>

        <!-- Dynamic file appender -->
        <Routing name="FileRouter">
            <Routes pattern="${ctx:hand}">
                <Route>
                    <File name="File-${ctx:hand}" fileName="server/logs/match${ctx:match}_hand${ctx:hand}.log">
                        
                        <PatternLayout 
                            pattern="%d{yyyy/MM/dd HH:mm:ss} -> %-5level : %msg%n"/>

                        <ThresholdFilter level="info"
                                         onMatch="ACCEPT"
                                         onMismatch="DENY"/>

                    </File>
                </Route>
            </Routes>
        </Routing>

        <Routing name="HandHistoryRouter">
            <Routes pattern="${ctx:hand}">
                <Route>
                    <File name="HandHistory-${ctx:hand}"
                        fileName="server/data/match_${ctx:match}/hand_${ctx:hand}.txt">

                        <PatternLayout pattern="%msg%n"/>

                    </File>
                </Route>
            </Routes>
        </Routing>
    </Appenders>

    <Loggers>
        <Root level="info">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="FileRouter"/>
        </Root>

        <Logger name="handhistory" level="info" additivity="false">
            <AppenderRef ref="HandHistoryRouter"/>
        </Logger>

    </Loggers>

</Configuration>