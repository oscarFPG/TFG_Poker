<?xml version="1.0" encoding="UTF-8"?>

<Configuration status="WARN">

    <Appenders>

        <!-- Console Appender (DEBUG+) + use different colors for each level -->
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout 
                pattern="%d{yyyy/MM/dd HH:mm:ss} -> %highlight{[%-5level]}{
                        DEBUG=white,
                        INFO=green,
                        WARN=yellow,
                        ERROR=red,
                        FATAL=bright_red
                    } : %msg%n"/>
        </Console>

        <!-- File Appender (INFO+) -->
        <File name="FileLogger" fileName="logs/server.log">
            <PatternLayout 
                pattern="%d{yyyy/MM/dd HH:mm:ss} -> %-5level : %msg%n"/>
            
            <!-- Solo mostrar INFO, WARN, ERROR Y FATAL -->
            <ThresholdFilter level="info" 
                             onMatch="ACCEPT" 
                             onMismatch="DENY"/>
        </File>

    </Appenders>

    <Loggers>
        <Root level="debug">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="FileLogger"/>
        </Root>
    </Loggers>

</Configuration>